FROM alpine:3.21 AS tools
ARG TARGETARCH

RUN apk add --no-cache curl tar jq && mkdir -p /out/bin

# kubectl
RUN V=$(curl -fsSL --retry 3 https://dl.k8s.io/release/stable.txt) \
 && curl -fsSL --retry 3 -o /out/bin/kubectl \
    "https://dl.k8s.io/release/$V/bin/linux/${TARGETARCH}/kubectl" \
 && chmod +x /out/bin/kubectl

# flux
RUN V=$(curl -fsSL --retry 3 https://api.github.com/repos/fluxcd/flux2/releases/latest | jq -r .tag_name) \
 && VNUM=${V#v} \
 && curl -fsSL --retry 3 "https://github.com/fluxcd/flux2/releases/download/${V}/flux_${VNUM}_linux_${TARGETARCH}.tar.gz" \
    | tar xz -C /out/bin flux \
 && chmod +x /out/bin/flux

# helm
RUN V=$(curl -fsSL --retry 3 https://api.github.com/repos/helm/helm/releases/latest | jq -r .tag_name) \
 && curl -fsSL --retry 3 "https://get.helm.sh/helm-${V}-linux-${TARGETARCH}.tar.gz" \
    | tar xz -C /tmp \
 && mv /tmp/linux-${TARGETARCH}/helm /out/bin/ \
 && chmod +x /out/bin/helm

# kustomize (latest release tagged as kustomize/vX.Y.Z)
RUN V=$(curl -fsSL --retry 3 "https://api.github.com/repos/kubernetes-sigs/kustomize/releases?per_page=30" \
    | jq -r '[.[] | select(.tag_name | startswith("kustomize/"))][0].tag_name' \
    | sed 's|kustomize/||') \
 && curl -fsSL --retry 3 "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2F${V}/kustomize_${V}_linux_${TARGETARCH}.tar.gz" \
    | tar xz -C /out/bin \
 && chmod +x /out/bin/kustomize

# yq
RUN curl -fsSL --retry 3 -o /out/bin/yq \
    "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_${TARGETARCH}" \
 && chmod +x /out/bin/yq

# sops
RUN V=$(curl -fsSL --retry 3 https://api.github.com/repos/getsops/sops/releases/latest | jq -r .tag_name) \
 && curl -fsSL --retry 3 -o /out/bin/sops \
    "https://github.com/getsops/sops/releases/download/${V}/sops-${V}.linux.${TARGETARCH}" \
 && chmod +x /out/bin/sops

# jq (install to /out/bin, replacing the apk one used during build)
RUN curl -fsSL --retry 3 -o /out/bin/jq \
    "https://github.com/jqlang/jq/releases/latest/download/jq-linux-${TARGETARCH}" \
 && chmod +x /out/bin/jq

FROM scratch
COPY --from=tools /out/bin/ /bin/
COPY workspace/ /workspace/
