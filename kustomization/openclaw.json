{
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "allowTailscale": true
    },
    "controlUi": {
      "enabled": true,
      "allowInsecureAuth": true
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "llama-cpp": {
        "baseUrl": "http://stpetersburg-llama-cpp/v1",
        "apiKey": "unused",
        "api": "openai-completions",
        "models": [
          {
            "id": "Qwen3-Coder-Next",
            "name": "Qwen3 Coder Next",
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 8192
          }
        ]
      },
      "anthropic": {
        "baseUrl": "https://api.anthropic.com",
        "apiKey": "$${ANTHROPIC_API_KEY}",
        "api": "anthropic-messages",
        "models": [
          {
            "id": "claude-opus-4-6",
            "name": "Claude Opus 4.6",
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 32000
          }
        ]
      },
      "nvidia": {
        "baseUrl": "https://integrate.api.nvidia.com/v1",
        "apiKey": "$${NVIDIA_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "moonshotai/kimi-k2.5",
            "name": "Kimi K2.5",
            "input": ["text"],
            "contextWindow": 131072,
            "maxTokens": 16384,
            "reasoning": true
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspaces/main",
      "model": {
        "primary": "nvidia/moonshotai/kimi-k2.5"
      },
      "userTimezone": "America/New_York",
      "timeoutSeconds": 600,
      "maxConcurrent": 1,
      "subagents": {
        "maxConcurrent": 8
      },
      "compaction": {
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 4000
        }
      },
      "memorySearch": {
        "enabled": true,
        "experimental": {
          "sessionMemory": true
        },
        "sources": ["memory", "sessions"]
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "identity": {
          "name": "OpenClaw",
          "emoji": "🦞"
        },
        "model": {
          "primary": "nvidia/moonshotai/kimi-k2.5"
        },
        "subagents": {
          "allowAgents": ["morty"]
        },
        "heartbeat": {
          "every": "30m",
          "model": "nvidia/moonshotai/kimi-k2.5",
          "target": "discord",
          "activeHours": {
            "start": "08:00",
            "end": "23:00",
            "timezone": "America/New_York"
          }
        }
      },
      {
        "id": "morty",
        "identity": {
          "name": "Morty",
          "emoji": "🔧"
        },
        "workspace": "/home/node/.openclaw/workspaces/morty",
        "model": {
          "primary": "nvidia/moonshotai/kimi-k2.5"
        },
        "subagents": {
          "model": "llama-cpp/Qwen3-Coder-Next",
          "allowAgents": ["main"]
        }
      }
    ]
  },
  "session": {
    "scope": "per-sender",
    "idleMinutes": 60
  },
  "logging": {
    "level": "info",
    "consoleStyle": "compact",
    "redactSensitive": "tools"
  },
  "tools": {
    "profile": "full",
    "web": {
      "search": {
        "enabled": true,
        "provider": "brave",
        "apiKey": "$${BRAVE_SEARCH_API_KEY}"
      },
      "fetch": {
        "enabled": true
      }
    }
  },
  "channels": {
    "discord": {
      "enabled": true,
      "groupPolicy": "open",
      "guilds": {
        "*": {
          "requireMention": false
        }
      },
      "dm": {
        "policy": "pairing"
      },
      "configWrites": true
    }
  }
}
